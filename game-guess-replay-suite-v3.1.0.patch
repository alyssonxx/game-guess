+rules_version = '2';
+service firebase.storage {
+  match /b/{bucket}/o {
+    match /arcade-replays/{seasonId}/{uid}/{replayId}/{fileName} {
+      // Replays compartilhados são lidos somente por usuários autenticados.
+      // A visibilidade fina (participantes/público) é validada no Realtime Database.
+      allow read: if request.auth != null;
+      allow create, update: if request.auth != null
+        && request.auth.uid == uid
+        && request.resource.size < 110 * 1024 * 1024
+        && request.resource.metadata.uploaderUid == request.auth.uid
+        && request.resource.metadata.replayId == replayId;
+      allow delete: if request.auth != null && request.auth.uid == uid;
+    }
+  }
+}
