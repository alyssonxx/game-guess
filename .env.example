# Configure em Vercel > Project > Settings > Environment Variables
IGDB_CLIENT_ID=seu_client_id
IGDB_CLIENT_SECRET=seu_client_secret

# KOF V17 — opcionais. Sem estes valores o jogo usa o servidor público
# do EmulatorJS e STUN público. Para redes/NAT restritos, configure TURN.
KOF_NETPLAY_SERVER=https://netplay.emulatorjs.org/
KOF_TURN_URL=
KOF_TURN_USERNAME=
KOF_TURN_CREDENTIAL=

# GeoGuess 360° — Maps JavaScript API com Street View
# Use uma chave de navegador restrita ao domínio do site.
GOOGLE_MAPS_API_KEY=
