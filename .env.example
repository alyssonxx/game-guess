# Configure em Vercel > Project > Settings > Environment Variables
IGDB_CLIENT_ID=seu_client_id
IGDB_CLIENT_SECRET=seu_client_secret

# KOF V19.1 — obrigatório para PVP online.
# Hospede o EmulatorJS-Netplay oficial (ex.: Render) e cole a URL HTTPS abaixo.
# Exemplo: https://game-guess-netplay.onrender.com
KOF_NETPLAY_SERVER=

# TURN é opcional. Só precisa se alguns jogadores não conseguirem formar o WebRTC
# por causa de NAT/rede móvel muito restritiva.
KOF_TURN_URL=
KOF_TURN_USERNAME=
KOF_TURN_CREDENTIAL=

# GeoGuess gratuito — Client Token do Mapillary
MAPILLARY_ACCESS_TOKEN=

# Google: mantenha desativado até concluir GEOGUESS-GOOGLE-MAPS-SETUP.md.
GEOGUESS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_SAFETY_CONFIRMED=false
GOOGLE_MAPS_MONTHLY_LIMIT=4000
GOOGLE_MAPS_ALLOWED_ORIGINS=https://game-guess-bay.vercel.app
# Credencial privada SOMENTE nas variáveis do servidor, nunca no JS do navegador.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
