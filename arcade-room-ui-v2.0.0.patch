+.arcade-online-choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.arcade-online-choice-card{display:grid;grid-template-columns:auto minmax(0,1fr);gap:12px;padding:18px;border:1px solid #273653;border-radius:18px;background:linear-gradient(145deg,#101a30,#0a1224)}.arcade-online-choice-icon{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:rgba(66,232,255,.08);font-size:1.4rem}.arcade-online-choice-card h3{margin:2px 0 5px}.arcade-online-choice-card p{margin:0;color:#8e9bb5;line-height:1.45;font-size:.8rem}.arcade-online-big-btn,.arcade-online-code-row{grid-column:1/-1}.arcade-online-big-btn{min-height:48px}.arcade-online-code-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}.arcade-online-code-row input{min-width:0;width:100%;border:1px solid #344462;border-radius:12px;background:#091225;color:#fff;padding:13px 14px;text-align:center;text-transform:uppercase;letter-spacing:.18em;font:800 1rem 'Orbitron',sans-serif;outline:none}.arcade-online-code-row input:focus{border-color:#4bdcff;box-shadow:0 0 0 3px rgba(75,220,255,.08)}
+.arcade-room-v2{display:grid;gap:14px;padding:18px;border:1px solid rgba(69,229,176,.24);border-radius:19px;background:radial-gradient(circle at 100% 0,rgba(51,222,171,.08),transparent 34%),#0a1425}.arcade-room-v2-code{display:flex;align-items:center;gap:10px}.arcade-room-v2-code>span{color:#8d9ab4;font:800 .67rem 'Orbitron',sans-serif}.arcade-room-v2-code strong{font:900 clamp(1.45rem,4vw,2rem) 'Orbitron',sans-serif;letter-spacing:.13em;color:#fff}.arcade-room-v2-code .icon-btn{margin-left:auto}.arcade-room-v2-game{color:#7fe7ff;font-weight:800}.arcade-room-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.arcade-room-steps>div{display:grid;grid-template-columns:auto 1fr;gap:2px 8px;align-items:center;padding:10px;border:1px solid #263650;border-radius:12px;background:#0d172a}.arcade-room-steps>div>span{grid-row:1/3;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#182844;color:#62e5ff;font:900 .69rem 'Orbitron'}.arcade-room-steps b{font-size:.73rem}.arcade-room-steps small{color:#8190aa;font-size:.63rem}.arcade-room-v2-players{display:grid;gap:8px}.arcade-player-row-v2{border:1px solid #263650;border-radius:12px;background:#0c1629;padding:10px 12px}.arcade-room-v2-status{padding:12px 14px;border-radius:12px;background:#0e1b2f;color:#dbe7f9;font-weight:800}.arcade-room-v2-buttons{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}.arcade-room-v2-buttons .primary-btn{min-height:50px}.arcade-online-help{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin-top:2px}
+.arcade-play-v2-head{grid-template-columns:auto minmax(0,1fr) auto}.arcade-play-v2-state{align-self:center;justify-self:end;max-width:360px;padding:8px 11px;border-radius:999px;border:1px solid #2a3958;background:#0b1426;color:#9daac1;font-size:.72rem;font-weight:800}.arcade-play-v2-state[data-kind="ok"]{border-color:rgba(77,231,176,.28);color:#75edbd}.arcade-play-v2-state[data-kind="error"]{border-color:rgba(255,100,120,.32);color:#ff8797}.arcade-play-v2-state[data-kind="loading"]{color:#71e5ff}
